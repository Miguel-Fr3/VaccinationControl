<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- O gerador de OpenAPI lê os comentários XML; sem o arquivo, os summary dos
         controllers não chegam ao documento nem ao Scalar. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin direto: Microsoft.AspNetCore.OpenApi 10.0.10 traz Microsoft.OpenApi 2.0.0,
         vulnerável (GHSA-v5pm-xwqc-g5wc, corrigido em 2.7.5). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaccinationControl.Application\VaccinationControl.Application.csproj" />
    <ProjectReference Include="..\VaccinationControl.Infrastructure\VaccinationControl.Infrastructure.csproj" />
  </ItemGroup>

</Project>
